{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "registry:build": {
      "inputs": ["registry.json", "registry/**"],
      "outputs": ["public/r/**"]
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "registry:build"]
    },
    "test:registry": {
      "dependsOn": ["registry:build"],
      "cache": false
    },
    "test:migration": {
      "dependsOn": ["registry:build"],
      "cache": false
    }
  }
}
